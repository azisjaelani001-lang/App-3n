rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Validasi data penerima manfaat
    function isValidBeneficiary() {
      return request.resource.data.nama is string
        && request.resource.data.posyandu is string;
    }

    // Validasi data pengguna
    function isValidUser() {
      return request.resource.data.nama is string
        && request.resource.data.role in ['admin', 'kader'];
    }

    match /beneficiaries/{beneficiaryId} {
      allow read: if true;
      allow create, update: if isValidBeneficiary();
      allow delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser();
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
